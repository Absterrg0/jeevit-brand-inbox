# Not needed for the default run: `npm run analyze` replays recorded model responses.
# Only `--live` / `--fresh` call a model. Set ONE of the keys below (all have free tiers),
# or none of them to use a local Ollama at http://localhost:11434.

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides.
# LLM_PROVIDER=groq            # groq | gemini | openrouter | ollama (default: first key found, else ollama)
# LLM_MODEL=                   # default per provider, see src/llm/provider.ts
# LLM_BASE_URL=                # any OpenAI-compatible endpoint
# LLM_TIMEOUT_MS=60000         # raise this for a local model on CPU
