{
  "name": "jeevit-brand-inbox",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Brand deal inbox assistant for creators: an LLM reads the emails, plain code makes the decisions",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "analyze": "tsx src/cli/analyze.ts",
