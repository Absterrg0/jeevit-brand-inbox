# Not needed for the default run: `npm run analyze` replays recorded model responses.
# Only `--live` / `--fresh` call a model. Set ONE of the keys below (all have free tiers).
# With no key, `--live` stops with an error; it never guesses.

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides.
# LLM_PROVIDER=groq            # groq | gemini | openrouter | ollama (default: first key found;
#                              # ollama is opt-in only: local, free, no key, slow on CPU)
# LLM_MODEL=                   # default per provider, see src/llm/provider.ts
# LLM_BASE_URL=                # any OpenAI-compatible endpoint
# LLM_TIMEOUT_MS=60000
